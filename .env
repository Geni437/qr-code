# Local Supabase config. This file IS committed with placeholder values so
# `flutter run`/`flutter build` work out of the box; replace the values below
# with your real project's URL + anon key (Settings -> API in the Supabase
# dashboard). The anon key is safe to expose client-side — it's protected by
# Row Level Security, not secrecy. Never put a service-role key here.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
